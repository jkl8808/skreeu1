# 桌面开发镜像（SDL2 模拟器）
#
#   docker build -t u1ui-dev:1 -f docker/Dockerfile.dev .
#   docker run --rm --network host -v $PWD:/src -w /src u1ui-dev:1 \
#     bash -c 'cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j'
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        ca-certificates \
        libsdl2-dev \
        libfreetype-dev \
        libpng-dev \
        libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

CMD ["bash"]
