# SKREEU1 交叉编译工具链（aarch64 / Snapmaker U1）
#
#   docker build -t skreeu1-cross:1 -f docker/Dockerfile.cross .
#   docker run --rm -v $PWD:/src -w /src skreeu1-cross:1
#
# 目标机是 Buildroot，glibc 2.38；这里用 Ubuntu 22.04（glibc 2.35）保证符号兼容。
# 链接用的 .so 直接从打印机上拷到 sysroot/（libfreetype.so.6 / libpng16.so.16 /
# libcurl.so.4），头文件用宿主 dev 包。libstdc++ 与 libgcc 静态链接。
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        crossbuild-essential-arm64 \
        cmake \
        make \
        pkg-config \
        ca-certificates \
        file \
        libfreetype-dev \
        libpng-dev \
        libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# 只暴露必要的头文件目录，避免把宿主机的 multiarch <bits/...> 带进交叉编译
RUN mkdir -p /opt/u1include && cp -a /usr/include/x86_64-linux-gnu/curl /opt/u1include/

WORKDIR /src

CMD ["bash", "scripts/build_device.sh"]
